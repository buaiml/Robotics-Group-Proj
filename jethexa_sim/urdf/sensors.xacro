<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Sensor payload of the JetHexa Advanced Kit, for Gazebo Harmonic (gz-sim 8):
      - EAI G4 360-deg 2D lidar, mast-mounted above the chassis
      - 3D depth camera (RGB + depth), front-facing
      - IMU on the controller board

    Sensors publish on gz transport topics. `config/gz_bridge.yaml` maps them
    onto ROS topics under /jethexa. The world must load the sensors and imu
    system plugins or these produce nothing - see worlds/flat_ground.sdf.

    Mount poses are approximate; re-measure against the real frame.
  -->
  <xacro:macro name="jethexa_sensors">

    <!-- ================= 2D LIDAR ================= -->
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="lidar_link"/>
      <origin xyz="-0.020 0 ${body_z/2 + 0.060}" rpy="0 0 0"/>
    </joint>

    <!-- Keep this link separate through URDF->SDF conversion, so the sensor
         sits on its own frame instead of being folded into the chassis. -->
    <gazebo reference="lidar_joint">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="lidar_link">
      <visual>
        <geometry><cylinder radius="0.035" length="0.040"/></geometry>
        <material name="lidar_blue"><color rgba="0.1 0.2 0.5 1"/></material>
      </visual>
      <collision name="lidar_collision">
        <geometry><cylinder radius="0.035" length="0.040"/></geometry>
      </collision>
      <inertial>
        <mass value="0.18"/>
        <inertia ixx="8e-5" iyy="8e-5" izz="1.1e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- ================= DEPTH CAMERA ================= -->
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="camera_link"/>
      <origin xyz="${body_x/2} 0 0.015" rpy="0 0 0"/>
    </joint>

    <!-- Keep this link separate through URDF->SDF conversion, so the sensor
         sits on its own frame instead of being folded into the chassis. -->
    <gazebo reference="camera_joint">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="camera_link">
      <visual>
        <geometry><box size="0.025 0.110 0.030"/></geometry>
        <material name="camera_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision name="camera_collision">
        <geometry><box size="0.025 0.110 0.030"/></geometry>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <inertia ixx="1.3e-4" iyy="2e-5" izz="1.3e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- REP-103 optical frame (z forward, x right) for image consumers -->
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child  link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="camera_optical_frame"/>

    <gazebo reference="camera_link">
      <!-- RGB and depth are separate sensors in gz-sim. -->
      <sensor name="rgb_camera" type="camera">
        <topic>rgb_camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="depth_camera" type="depth_camera">
        <topic>depth_camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- ================= IMU ================= -->
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="imu_link"/>
      <origin xyz="0 0 ${body_z/2}" rpy="0 0 0"/>
    </joint>

    <!-- Keep this link separate through URDF->SDF conversion, so the sensor
         sits on its own frame instead of being folded into the chassis. -->
    <gazebo reference="imu_joint">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="imu_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-3</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-3</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-3</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
