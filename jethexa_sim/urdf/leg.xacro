<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    One 3-DoF leg. Frame convention (matches the usual hexapod IK write-up):
      coxa joint  : yaw   about z, rotates the whole leg in the horizontal plane
      femur joint : pitch about y, lifts the leg
      tibia joint : pitch about y, extends/folds the foot
    Each segment runs along its own +x axis.
  -->
  <xacro:macro name="leg" params="name x y yaw">

    <!-- coxa -->
    <joint name="${name}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${name}_coxa_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 ${yaw}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-joint_limit}" upper="${joint_limit}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${name}_coxa_link">
      <visual>
        <origin xyz="${coxa_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${seg_r}" length="${coxa_len}"/></geometry>
        <material name="jethexa_leg"><color rgba="0.55 0.55 0.58 1"/></material>
      </visual>
      <collision name="${name}_coxa_collision">
        <origin xyz="${coxa_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${seg_r}" length="${coxa_len}"/></geometry>
      </collision>
      <xacro:rod_inertial m="${coxa_mass}" l="${coxa_len}" r="${seg_r}"/>
    </link>

    <!-- femur -->
    <joint name="${name}_femur_joint" type="revolute">
      <parent link="${name}_coxa_link"/>
      <child  link="${name}_femur_link"/>
      <origin xyz="${coxa_len} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-joint_limit}" upper="${joint_limit}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${name}_femur_link">
      <visual>
        <origin xyz="${femur_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${seg_r}" length="${femur_len}"/></geometry>
        <material name="jethexa_leg"/>
      </visual>
      <collision name="${name}_femur_collision">
        <origin xyz="${femur_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${seg_r}" length="${femur_len}"/></geometry>
      </collision>
      <xacro:rod_inertial m="${femur_mass}" l="${femur_len}" r="${seg_r}"/>
    </link>

    <!-- tibia, with the foot as a second collision on the same link -->
    <joint name="${name}_tibia_joint" type="revolute">
      <parent link="${name}_femur_link"/>
      <child  link="${name}_tibia_link"/>
      <origin xyz="${femur_len} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-joint_limit}" upper="${joint_limit}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!--
      The foot is a named collision on the tibia rather than its own link on a
      fixed joint. It was originally moved here to dodge sdformat's collision
      rename - that did not work, because sdformat prefixes EVERY collision
      with <link>_fixed_joint_lump__, revolute-jointed links included. It is
      kept this way regardless: six fewer links and six fewer weld constraints
      for the solver, for no loss, since nothing needs a foot TF frame.
    -->
    <link name="${name}_tibia_link">
      <visual>
        <origin xyz="${tibia_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${seg_r*0.8}" length="${tibia_len}"/></geometry>
        <material name="jethexa_leg"/>
      </visual>
      <collision name="${name}_shin_collision">
        <origin xyz="${tibia_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${seg_r*0.8}" length="${tibia_len}"/></geometry>
      </collision>

      <!-- foot: the only geometry that should normally touch the ground -->
      <visual>
        <origin xyz="${tibia_len} 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${foot_r}"/></geometry>
        <material name="jethexa_foot"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision name="${name}_foot_collision">
        <origin xyz="${tibia_len} 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${foot_r}"/></geometry>
      </collision>

      <xacro:rod_inertial m="${tibia_mass}" l="${tibia_len}" r="${seg_r*0.8}"/>
    </link>

    <!--
      NO FOOT CONTACT SENSORS. Two reasons, in order of importance:

      1. The real JetHexa has no foot switches, so a policy that consumes foot
         contact cannot be deployed. The observation space excludes it by
         design - see docs/jethexa_hardware.md.
      2. They did not work anyway. Contact sensors on a URDF-spawned model in
         ROS 2 Humble + Gazebo Harmonic advertise their topic and then publish
         nothing, whichever collision name they reference. Verified on both the
         as-written and the sdformat-emitted name.

      If contact-based reward shaping is wanted later, do it in the MuJoCo
      training sim, where contacts are directly available - that is where
      training happens anyway. If Gazebo contacts are genuinely needed, the
      model has to be authored in SDF rather than converted from URDF.

      Friction is not set per link at all. <mu1>/<mu2> attach by collision name
      and sdformat renames collisions, so they silently did nothing and were
      removed. Contact friction comes from the ground surface in the world file
      combined with gz's default, which lands near rubber-on-concrete. The cost:
      we cannot make the feet grippier than the shins, so a policy that learns
      to shuffle on its shins is not being penalised for it. Fixing that
      properly means authoring the model in SDF instead of URDF.
    -->

  </xacro:macro>
</robot>
